---
import Layout from '../layouts/Layout.astro';
import FileUpload from '../components/FileUpload.astro';
import ViewRounds from '../components/ViewRounds.astro';
import ViewUsers from '../components/ViewUsers.astro';

---

<Layout title="Disc golf dashboard">
  <main>
    <h1>Disc golf statistics dashboard</h1>
    <p>Work in progress.</p>

    <section>
      <h2>Upload Round</h2>
      <FileUpload />
    </section>

    <div class="split-container">
      <div class="box">
        <h2>View Rounds</h2>
        <section>
          <ViewRounds />
        </section>
      </div>
      <div class="box">
        <h2>View Users</h2>
        <section>
          <ViewUsers />
        </section>
      </div>
    </div>

  </main>
</Layout>

<style>
  .split-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    width: 100%;
  }

  .box {
    box-sizing: border-box;
    padding: 1.5rem;
    background-color: #f0f4f8;
    border: 1px solid #cbd5e1;
  }
</style>

