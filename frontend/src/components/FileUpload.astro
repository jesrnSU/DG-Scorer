<form id="round-upload">
  <label>
    Round CSV file
    <input name="file" type="file" accept=".csv,text/csv" required />
  </label>
  <button type="submit">Upload</button>
  <p role="status"></p>
</form>

<script>
  import { saveRound } from '../lib/api';
  import { parseRoundCsv } from '../lib/roundCsv';

  const form = document.querySelector<HTMLFormElement>('#round-upload')!;
  const input = form.querySelector<HTMLInputElement>('input')!;
  const button = form.querySelector<HTMLButtonElement>('button')!;
  const status = form.querySelector<HTMLParagraphElement>('[role="status"]')!;

  form.addEventListener('submit', async event => {
    event.preventDefault();
    const file = input.files?.[0];
    if (!file || button.disabled) return;

    button.disabled = true;
    status.textContent = 'Uploading…';
    try {
      const round = parseRoundCsv(await file.text());
      const saved = await saveRound(round);
      status.textContent = `Round saved. ID: ${saved.id}`;
      form.reset();
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : 'Upload failed.';
    } finally {
      button.disabled = false;
    }
  });
</script>
