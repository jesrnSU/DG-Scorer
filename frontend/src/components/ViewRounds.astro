<form id="view-rounds">
  <label>
    Username
    <input name="username" type="text" required />
  </label>
  <button id="view-button" type="submit">Fetch</button>
  <pre id="round-info" role="status"></pre>
</form>

<script>
  import { getUserRounds } from '../lib/api';

  const form = document.querySelector<HTMLFormElement>('#view-rounds')!;
  const username = form.querySelector<HTMLInputElement>('input')!;
  const button = form.querySelector<HTMLButtonElement>('#view-button')!;
  const info = form.querySelector<HTMLPreElement>('#round-info')!;

  form.addEventListener('submit', async event => {
    event.preventDefault();
    button.disabled = true;
    info.textContent = 'Loading…';

    try {
      const rounds = await getUserRounds(username.value);
      info.textContent = rounds.length ? JSON.stringify(rounds, null, 2) : 'No rounds found.';
    } catch (error) {
      info.textContent = error instanceof Error ? error.message : 'Could not fetch round.';
    } finally {
      button.disabled = false;
    }
  });
</script>
