<form id="view-users">
  <label>
    View All Users
  </label>
  <button id="view-users-button" type="submit">Fetch All</button>
  <pre id="users-info" role="status"></pre>
</form>

<script>
  import { getAllUsers } from '../lib/api';

  const form = document.querySelector<HTMLFormElement>('#view-users')!;
  const button = form.querySelector<HTMLButtonElement>('#view-users-button')!;
  const info = form.querySelector<HTMLPreElement>('#users-info')!;

  form.addEventListener('submit', async event => {
    event.preventDefault();
    button.disabled = true;
    info.textContent = 'Loading...';

    try{
      const users = await getAllUsers();
      info.textContent = users.length ? JSON.stringify(users, null, 2) : 'No users found.';
    } catch (error) {
      info.textContent = error instanceof Error ? error.message: 'Could not fetch users';
    } finally {
      button.disabled = false;
    }
  });
</script>

